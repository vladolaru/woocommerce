{
	"name": "@woocommerce/paypal-wallet",
	"private": true,
	"version": "1.0.0",
	"description": "Build, tests and lint for the PayPal wallet JS forked from the PayPal Payments extension.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "pnpm build:project",
		"build:project": "wp-scripts build",
		"watch:build": "wp-scripts start",
		"test:js": "wp-scripts test-unit-js --config jest.config.js",
		"lint": "pnpm --if-present '/^lint:lang:.*$/'",
		"lint:lang:js": "eslint 'modules/**/*.{js,jsx}'",
		"lint:fix:lang:js": "eslint 'modules/**/*.{js,jsx}' --fix"
	},
	"dependencies": {
		"@paypal/paypal-js": "^8.1.3",
		"@paypal/react-paypal-js": "^8.9.2",
		"@wordpress/icons": "catalog:wp-bundled",
		"classnames": "^2.5.1",
		"deepmerge": "^4.3",
		"formdata-polyfill": "^4.0.10",
		"react": "18.3.x",
		"react-dom": "18.3.x",
		"react-select": "^5.10.2"
	},
	"devDependencies": {
		"@babel/plugin-proposal-class-properties": "^7.18.6",
		"@babel/preset-env": "catalog:tooling",
		"@babel/preset-react": "catalog:tooling",
		"@babel/preset-typescript": "catalog:tooling",
		"@testing-library/dom": "^10.1.0",
		"@testing-library/jest-dom": "^6.4.6",
		"@testing-library/react": "^16.0.0",
		"@testing-library/user-event": "^14.5.2",
		"@woocommerce/dependency-extraction-webpack-plugin": "workspace:*",
		"@woocommerce/eslint-config": "workspace:*",
		"@wordpress/babel-preset-default": "next",
		"@wordpress/jest-preset-default": "next",
		"@wordpress/scripts": "32.6.0",
		"babel-jest": "29.5.x",
		"babel-plugin-explicit-exports-references": "^1.0.2",
		"copy-webpack-plugin": "13.0.x",
		"eslint": "^10.0.0",
		"jest": "29.5.x",
		"jquery": "^3.7.1"
	},
	"config": {
		"ci": {
			"lint": {
				"command": "lint",
				"changes": [ "modules/**/*.{js,jsx,scss}", "webpack.config.js", "jest.config.js", "babel.config.json" ]
			},
			"tests": [
				{
					"name": "JavaScript",
					"command": "test:js",
					"changes": [ "modules/**/*.{js,jsx,scss,json}", "tests/js/**/*.js", "webpack.config.js", "jest.config.js", "babel.config.json" ],
					"events": [ "pull_request", "push" ]
				}
			]
		}
	}
}
